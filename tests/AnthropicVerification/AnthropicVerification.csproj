<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AnthropicVerification</RootNamespace>
    <AssemblyName>AnthropicVerification</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic.SDK" />
    <!--
      Anthropic.SDK 5.10.0 was compiled against Microsoft.Extensions.AI.Abstractions 10.3.0.
      The repo's central pin has since moved to 10.11.0 (Microsoft.Agents.AI 1.27 requires 10.10.1+),
      and HostedMcpServerTool has dropped the AuthorizationToken property and the
      AuthorizationHeaderName field entirely, which causes a runtime MissingMethodException.
      Pin this throwaway harness to the SDK's compile-time targets via VersionOverride.
      This project sits outside AI in .Net.sln, so a green solution build does not cover it.
      Revisit when Anthropic.SDK ships a release built against current M.E.AI.
    -->
    <PackageReference Include="Microsoft.Extensions.AI" VersionOverride="10.3.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" VersionOverride="10.3.0" />
  </ItemGroup>

</Project>
